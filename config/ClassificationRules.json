{
  "$comment": "Edit this file to retune the classifier. First-match wins. Patterns are matched as -like wildcards against the full Path (no regex). 'marker' patterns are matched against individual child items in a folder to detect app/project status.",
  "defaultCategory": "Unknown",
  "defaultAction": "keep",
  "deleteAllowedCategories": [ "Junk" ],
  "archive": {
    "olderThanDays": 180,
    "folderPatterns": [ "*backup*", "*old*", "*archive*", "*-copy*", "* - copy*", "*legacy*", "*_v[0-9]*" ],
    "fileExtensions": [ ".zip", ".7z", ".rar", ".tar", ".tar.gz", ".tgz", ".tbz2", ".iso" ]
  },
  "junk": {
    "duplicateScanMaxSizeMB": 100,
    "logMaxSizeMB": 50,
    "filePatterns": [
      "*.tmp", "*.temp", "*.part", "*.partial", "*.crdownload", "*.download",
      "*.bak", "*.orig", "*.rej", "*.swp", "Thumbs.db", "desktop.ini",
      "~$*", "*.lnk.bak"
    ],
    "folderPatterns": [ "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache",
                        ".cache", ".tox", ".parcel-cache", ".turbo", ".gradle",
                        ".idea", ".vscode-test" ]
  },
  "categories": [
    {
      "name": "App",
      "action": "keep",
      "description": "Installed applications or runnable app folders. Never auto-acted on.",
      "match": {
        "pathContains": [ "\\Program Files\\", "\\Program Files (86)\\", "\\ProgramData\\Package Cache\\", "\\Windows\\System32\\" ],
        "markerFiles": [ "*.exe", "*.msi", "setup.exe", "Setup.exe", "unins000.exe",
                         "manifest.json", "*.iss", "winget-manifest.yaml" ]
      }
    },
    {
      "name": "Project",
      "action": "keep",
      "description": "Source-controlled or build-configured project root. Never auto-acted on.",
      "match": {
        "markerFiles": [
          ".git", ".svn", ".hg", ".bzr",
          "package.json", "pyproject.toml", "requirements.txt", "Pipfile", "poetry.lock",
          "Cargo.toml", "go.mod", "go.sum", "pom.xml", "build.gradle", "build.gradle.kts",
          "Makefile", "CMakeLists.txt", "*.csproj", "*.fsproj", "*.sln",
          "docker-compose.yml", "docker-compose.yaml", "Dockerfile"
        ]
      }
    },
    {
      "name": "HeavyCache",
      "action": "keep",
      "description": "Large reproducible cache. Surfaced in the report, never auto-quarantined. User must opt in via override.",
      "match": {
        "pathContains": [
          "\\AppData\\Local\\Packages\\", "\\LocalCache\\",
          "\\AppData\\Local\\OneDrive\\",
          "\\AppData\\Local\\Python\\pythoncore-",
          "\\AppData\\Local\\ollama\\",
          "\\.ollama\\",
          "\\AppData\\Local\\Microsoft\\Windows\\Explorer\\",
          "\\AppData\\Local\\CrashDumps\\",
          "\\Windows\\WinSxS\\", "\\Windows\\Installer\\", "\\Windows\\Temp\\",
          "\\Windows\\SoftwareDistribution\\Download\\",
          "\\ProgramData\\Package Cache\\"
        ]
      }
    },
    {
      "name": "Archive",
      "action": "archive",
      "description": "Old backups, archive folders, compressed files. Grouped into _Archive by default.",
      "match": {
        "pathLike": [ "*\\backup*", "*\\old*", "*\\archive*", "*\\legacy*", "*\\*_v[0-9]*" ]
      }
    },
    {
      "name": "Junk",
      "action": "quarantine",
      "description": "Temp/lock/cache files outside of an active project. Soft-deleted to _Quarantine by default.",
      "match": {
        "nameLike": [ "*.tmp", "*.temp", "*.part", "*.partial", "*.crdownload", "*.download",
                      "*.bak", "*.orig", "*.rej", "*.swp", "Thumbs.db", "desktop.ini",
                      "~*", "~$*" ],
        "nameEquals": [ "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache",
                        ".cache", ".tox", ".parcel-cache", ".turbo" ]
      }
    },
    {
      "name": "Data",
      "action": "keep",
      "description": "Documents, media, fonts, configs. User data — left alone by default.",
      "match": {
        "pathContains": [ "\\Documents\\", "\\Desktop\\", "\\Downloads\\", "\\Pictures\\",
                          "\\Videos\\", "\\Music\\", "\\OneDrive\\Documents\\",
                          "\\OneDrive\\Desktop\\", "\\OneDrive\\Pictures\\" ]
      }
    },
    {
      "name": "System",
      "action": "keep",
      "description": "Windows system files. Never auto-acted on.",
      "match": {
        "pathContains": [ "\\Windows\\", "\\System32\\", "\\SysWOW64\\",
                          "\\WinSxS\\", "\\Windows\\Boot\\", "\\Windows\\CSC\\" ]
      }
    }
  ],
  "sizeBandsMB": {
    "huge": 1024,
    "large": 256,
    "medium": 64
  }
}
