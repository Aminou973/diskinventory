[
  {
    "_comment": "Linux overlay. Merged AFTER config/classification.json. Additive — earlier rules in the base still win.",
    "category": "App",
    "match": {
      "pathContains": ["/usr/bin", "/usr/local/bin", "/opt/", "/snap/", "/.local/bin"]
    }
  },
  {
    "category": "System",
    "match": {
      "pathContains": ["/usr/lib", "/usr/share", "/etc", "/var/lib", "/var/cache", "/var/log", "/var/tmp", "/boot", "/sys/", "/proc/", "/run/", "/dev/", "/lib/", "/lib64/"]
    }
  },
  {
    "category": "HeavyCache",
    "match": {
      "pathContains": ["/go/pkg/mod", "/.cargo/registry", "/.npm/_cacache", "/.cache/pip", "/.cache/yarn", "/.cache/pnpm", "/.gradle/", "/.m2/repository", "/.nuget/packages", "/.docker/"]
    }
  },
  {
    "category": "HeavyCache",
    "match": {
      "markerFiles": ["Cargo.lock", "go.sum", "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "Pipfile.lock", "poetry.lock"]
    }
  },
  {
    "category": "Project",
    "match": {
      "markerFiles": [".git", ".svn", ".hg", "package.json", "pyproject.toml", "Cargo.toml", "go.mod", "pom.xml", "build.gradle", "build.gradle.kts", "composer.json", "*.csproj", "*.sln", "meson.build", "Makefile", "CMakeLists.txt"]
    }
  },
  {
    "category": "Trash",
    "match": {
      "pathContains": ["/.local/share/Trash", "/.Trash", "/Trash"]
    }
  }
]
