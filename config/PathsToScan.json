{
  "$comment": "Every entry here is a PROBE, not a hard-coded path. The tool checks existence and readability at runtime; missing/unreadable entries are silently skipped and noted in the report header.",
  "scanRoots": {
    "allFixedDrives": true,
    "allUserProfiles": true,
    "perProfileStandardFolders": [ "Documents", "Desktop", "Downloads",
                                    "AppData\\Roaming", "AppData\\Local",
                                    "Pictures", "Videos", "Music" ],
    "perProfileOptionalFolders": [ ".claude", "Claude", ".ollama", ".android",
                                   ".config", "source", "repos", "Projects" ],
    "commonProjectRoots": [
      "C:\\Projects", "C:\\Repos", "C:\\src", "C:\\code", "C:\\dev",
      "C:\\inetpub", "C:\\Tools", "C:\\ProgramData"
    ],
    "perUserProjectRoots": [ "source", "repos", "Projects" ],
    "adminOnlyRoots": [
      "C:\\Program Files", "C:\\Program Files (x86)", "C:\\Windows"
    ]
  },
  "excludeGlobs": [
    "$Recycle.Bin", "System Volume Information", "Config.Msi", "MSOCache",
    "Windows\\WinSxS", "Windows\\Installer\\$PatchCache$",
    "Windows\\SoftwareDistribution\\Download",
    ".git\\objects", ".git\\lfs\\objects", ".svn", ".hg",
    "node_modules", "bower_components", "jspm_packages",
    "venv", ".venv", "env",
    "__pycache__", ".pytest_cache", ".tox", ".cache",
    ".mypy_cache", ".ruff_cache", ".parcel-cache", ".turbo",
    "AppData\\Local\\Temp",
    "AppData\\Local\\Microsoft\\Windows\\INetCache",
    "AppData\\Local\\Microsoft\\Windows\\Explorer",
    "AppData\\Local\\CrashDumps",
    "dist", "build", "out",
    "target\\debug", "target\\release",
    ".next", ".nuxt", ".svelte-kit", ".angular", "coverage"
  ],
  "excludeFileNames": [
    "Thumbs.db", "desktop.ini", "NTUSER.DAT", "ntuser.dat.LOG",
    "UsrClass.dat", "WMIC.exe", "pagefile.sys", "hiberfil.sys", "swapfile.sys"
  ],
  "excludeExtensions": [
    ".tmp", ".temp", ".part", ".partial", ".crdownload", ".download",
    ".log"
  ],
  "sizeCacheEnabled": true,
  "sizeCacheFileName": "size-cache.json",
  "quarantineRootName": "_Quarantine",
  "archiveRootName": "_Archive",
  "groupRootName": "_Grouped",
  "reportNamePrefix": "inventory"
}
