# DiskInventory .gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Build / distribution
build/
dist/
*.egg-info/
*.whl
*.zip

# DiskInventory runtime outputs
out/
fleet-out/
*.db

# Local state
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test scratch
spec/fixtures/_run/

# Screenshot scratch
docs/screenshots/*.tmp
docs/screenshots/*.bak
